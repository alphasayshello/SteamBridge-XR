<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback + CM WebSocket both need only INTERNET. No CAMERA (QR is displayed, not scanned),
         no storage (relay.txt/steamlogin.txt are placed once via adb — see README). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:label="SteamBridge-XR"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SteamBridge">

        <activity
            android:name=".AppEntryActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.LoopbackServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
